# Cloudflare R2: keep the real values only in foodie-backend/.env or the deployment secret store.
R2_BUCKET=foodie-private-documents
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
