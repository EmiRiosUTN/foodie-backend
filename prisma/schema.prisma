generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  platform_admin
}

enum RestaurantRole {
  restaurant_owner
  restaurant_manager
  host
  waiter
  cashier
  kitchen
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
  seated
  completed
  no_show
}

enum TableStateStatus {
  free
  reserved
  occupied
  blocked
}

enum Turn {
  mediodia
  noche
}

enum AuthScope {
  platform
  restaurant
}

enum ExternalRequestStatus {
  success
  error
}

enum ReservationSource {
  admin
  integration
  public_web
}

enum AdvanceUnit {
  days
  weeks
  months
}

enum BookingService {
  lunch
  dinner
}

enum BookingExceptionType {
  closed
  custom_hours
  fully_booked
  booking_disabled
}

enum AssistantUpdateCategory {
  menu
  hours
  event
  promotion
  general
}

enum AssistantUpdateValidity {
  indefinite
  single_date
  range
}

model PlatformUser {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         PlatformRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
}

model Restaurant {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  profileImageUrl   String?
  isActive          Boolean             @default(true)
  chatModuleEnabled Boolean             @default(false)
  chatClientId      String?
  chatWabaId        String?
  chatAccessToken   String?
  chatWorkflowId    String?
  chatPhoneNumberId String?
  chatAuthEmail     String?
  chatAuthSecret    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  branches          Branch[]
  users             RestaurantUser[]
  rooms             Room[]
  roomZones         RoomZone[]
  floorPlanItems    FloorPlanItem[]
  tables            Table[]
  tableCombinations TableCombination[]
  customers         Customer[]
  customerTags      CustomerTag[]
  reservations      Reservation[]
  serviceStates     ServiceState[]
  integrationTokens IntegrationToken[]
  externalApiRequests ExternalApiRequest[]
  auditLogs         AuditLog[]
  chatActivityLogs  ChatActivityLog[]
  onlineBooking     OnlineBookingSettings?
  customization     RestaurantCustomization?
  specials          RestaurantSpecial[]
  faqs              RestaurantFaq[]
  assistantUpdates  RestaurantAssistantUpdate[]
  bookingWindows    BookingWindow[]
  bookingCutoffs    BookingCutoffRule[]
  bookingExceptions BookingException[]
}

model RestaurantCustomization {
  id          String   @id @default(cuid())
  restaurantId String  @unique
  description String?
  address     String?
  mapsUrl     String?
  menuUrl     String?
  cuisineType String?
  city        String?
  province    String?
  country     String?
  phone       String?
  email       String?
  websiteUrl  String?
  instagramUrl String?
  assistantEnabled Boolean @default(true)
  assistantName String?
  assistantRole String?
  assistantLocale String @default("es-AR")
  assistantTone String @default("calido_breve_profesional")
  assistantFirstGreeting String?
  assistantDisclosure Boolean @default(true)
  humanSupportPhone String?
  humanSupportWhatsapp String?
  humanSupportEmail String?
  configVersion Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model RestaurantSpecial {
  id          String   @id @default(cuid())
  restaurantId String
  title       String
  description String?
  price       Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  externalUrl String?
  isActive    Boolean  @default(true)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive, startsAt, endsAt])
}

model RestaurantFaq {
  id           String     @id @default(cuid())
  restaurantId String
  topic        String
  question     String
  answer       String
  isActive     Boolean    @default(true)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive, position])
}

model RestaurantAssistantUpdate {
  id           String                  @id @default(cuid())
  restaurantId String
  title        String
  category     AssistantUpdateCategory @default(general)
  content      String
  isActive     Boolean                 @default(true)
  validityType AssistantUpdateValidity @default(indefinite)
  startsAt     DateTime?
  endsAt       DateTime?
  position     Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, isActive, position])
  @@index([restaurantId, isActive, startsAt, endsAt])
}

model RestaurantUser {
  id           String         @id @default(cuid())
  restaurantId String
  createdByUserId String?
  fullName     String
  email        String
  passwordHash String
  role         RestaurantRole
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdBy    RestaurantUser? @relation("RestaurantUserCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdUsers RestaurantUser[] @relation("RestaurantUserCreatedBy")
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  chatActivityLogs ChatActivityLog[]

  @@unique([restaurantId, email])
  @@index([restaurantId, role])
}

model Branch {
  id           String        @id @default(cuid())
  restaurantId String
  name         String
  publicSlug   String        @unique @default(cuid())
  onlineBookingDurationMinutes Int @default(180)
  timezone     String
  publicName   String?
  isEnabled    Boolean @default(true)
  publicBookingEnabled Boolean @default(true)
  address      String?
  mapsUrl      String?
  phone        String?
  whatsappPhone String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  rooms        Room[]
  customers    Customer[]
  reservations Reservation[]
  onlineBookingSchedules OnlineBookingSchedule[]
  onlineBookingExceptions OnlineBookingException[]
  bookingWindows BookingWindow[]
  bookingExceptions BookingException[]

  @@index([restaurantId])
}

model Room {
  id           String          @id @default(cuid())
  branchId      String
  restaurantId  String
  name          String
  description   String?
  isOutdoor     Boolean         @default(false)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorPlanItems FloorPlanItem[]
  zones         RoomZone[]
  tables        Table[]
  reservations  Reservation[]

  @@index([restaurantId, branchId])
}

model RoomZone {
  id           String   @id @default(cuid())
  roomId        String
  restaurantId  String
  name          String
  slug          String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tables        Table[]

  @@unique([roomId, slug])
  @@index([restaurantId])
}

model FloorPlanItem {
  id           String   @id @default(cuid())
  roomId        String
  restaurantId  String
  kind         String
  label        String?
  x            Float
  y            Float
  width        Float
  height       Float
  rotation     Float    @default(0)
  metadata     Json?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([restaurantId, roomId])
}

model Table {
  id            String             @id @default(cuid())
  roomId         String
  restaurantId   String
  zoneId         String?
  label         String
  shape         String
  seats         Int
  x             Float    @default(0)
  y             Float    @default(0)
  width         Float    @default(112)
  height        Float    @default(112)
  rotation      Float    @default(0)
  metadata      Json?
  isReservable  Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  room          Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  zone          RoomZone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  states        ServiceState[]
  reservationLinks ReservationTable[]
  parentCombinations TableCombination[] @relation("ParentTable")
  childCombinations  TableCombination[] @relation("ChildTable")

  @@unique([roomId, label])
  @@index([restaurantId, roomId])
}

model TableCombination {
  id             String @id @default(cuid())
  restaurantId   String
  parentTableId  String
  childTableId   String
  combinedSeats  Int
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  parentTable    Table  @relation("ParentTable", fields: [parentTableId], references: [id], onDelete: Cascade)
  childTable     Table  @relation("ChildTable", fields: [childTableId], references: [id], onDelete: Cascade)

  @@unique([parentTableId, childTableId])
  @@index([restaurantId])
}

model Customer {
  id             String        @id @default(cuid())
  restaurantId   String
  branchId       String?
  fullName       String
  phone          String?
  email          String?
  birthday       DateTime?
  notes          String?
  reservationCount Int        @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tags           CustomerTag[]
  reservations   Reservation[]

  @@index([restaurantId, branchId])
  @@index([restaurantId, email])
  @@unique([restaurantId, email])
}

model OnlineBookingSettings {
  id                String   @id @default(cuid())
  restaurantId      String   @unique
  isEnabled         Boolean  @default(false)
  coverImageUrl     String?
  whatsappPhone     String?
  accentColor       String   @default("#FF5A00")
  minAdvanceMinutes Int      @default(60)
  maxAdvanceDays    Int      @default(60)
  maximumAdvanceValue Int @default(60)
  maximumAdvanceUnit AdvanceUnit @default(days)
  minPartySize      Int      @default(1)
  maxPartySize      Int      @default(12)
  largePartyThreshold Int?
  agencyPartyThreshold Int?
  remindersEnabled   Boolean  @default(false)
  reminderPartySizeFrom Int?
  reminderHoursBefore Int?
  showAddress       Boolean @default(false)
  showPhone         Boolean @default(false)
  showMenu          Boolean @default(false)
  showInstagram     Boolean @default(false)
  showGoogleMaps    Boolean @default(false)
  commentsEnabled   Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model OnlineBookingSchedule {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String
  weekday      Int
  isEnabled    Boolean  @default(true)
  startTime    String
  endTime      String
  intervalMin  Int      @default(30)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, weekday])
  @@index([restaurantId, branchId])
}

model OnlineBookingException {
  id           String   @id @default(cuid())
  restaurantId String
  branchId     String
  serviceDate  DateTime
  isClosed     Boolean  @default(false)
  startTime    String?
  endTime      String?
  intervalMin  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceDate])
  @@index([restaurantId, branchId, serviceDate])
}

model BookingWindow {
  id String @id @default(cuid())
  restaurantId String
  branchId String
  weekday Int
  service BookingService
  isEnabled Boolean @default(true)
  startTime String
  endTime String
  intervalMin Int @default(30)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, weekday, service])
  @@index([restaurantId, branchId])
}

model BookingCutoffRule {
  id String @id @default(cuid())
  restaurantId String
  service BookingService
  weekdays Int[]
  minimumAdvanceMinutes Int
  sameDayOnly Boolean @default(false)
  fallbackAction String @default("walk_in")
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  @@index([restaurantId])
}

model BookingException {
  id String @id @default(cuid())
  restaurantId String
  branchId String
  serviceDate DateTime
  type BookingExceptionType
  windows Json?
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  @@unique([branchId, serviceDate])
  @@index([restaurantId, branchId, serviceDate])
}

model CustomerTag {
  id          String   @id @default(cuid())
  customerId   String
  restaurantId String
  label       String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, customerId])
}

model Reservation {
  id             String              @id @default(cuid())
  restaurantId   String
  branchId       String
  roomId         String
  customerId     String?
  code           String              @unique
  fullName       String
  phone          String
  email          String?
  partySize      Int
  status         ReservationStatus   @default(pending)
  turn           Turn
  serviceDate    DateTime
  serviceTime    String              @default("20:00")
  preferredZone  String?
  notes          String?
  source         ReservationSource   @default(admin)
  durationMinutes Int                @default(180)
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  room           Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tables         ReservationTable[]

  @@index([restaurantId, branchId, serviceDate, turn])
  @@index([roomId, serviceDate, turn])
}

model ReservationTable {
  id            String       @id @default(cuid())
  reservationId String
  tableId       String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table         Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([reservationId, tableId])
}

model ServiceState {
  id            String           @id @default(cuid())
  restaurantId  String
  branchId      String
  roomId        String
  tableId       String
  reservationId String?
  serviceDate   DateTime
  turn          Turn
  status        TableStateStatus
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  restaurant    Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, reservationId])
  @@index([restaurantId, branchId, roomId, serviceDate, turn])
  @@index([tableId, serviceDate, turn])
}

model IntegrationToken {
  id            String   @id @default(cuid())
  restaurantId  String
  label         String
  tokenHash     String
  isActive      Boolean  @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  requests      ExternalApiRequest[]

  @@index([restaurantId])
}

model RefreshToken {
  id               String          @id @default(cuid())
  tokenHash        String          @unique
  scope            AuthScope
  platformUserId   String?
  restaurantUserId String?
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  ipAddress        String?
  lastUsedAt       DateTime?
  createdAt        DateTime        @default(now())
  platformUser     PlatformUser?   @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  restaurantUser   RestaurantUser? @relation(fields: [restaurantUserId], references: [id], onDelete: Cascade)

  @@index([scope, expiresAt])
  @@index([platformUserId])
  @@index([restaurantUserId])
}

model ExternalApiRequest {
  id                 String                @id @default(cuid())
  restaurantId       String
  integrationTokenId String
  action             String
  idempotencyKey     String?
  requestHash        String
  status             ExternalRequestStatus
  responseData       Json?
  errorMessage       String?
  createdAt          DateTime              @default(now())
  processedAt        DateTime?
  restaurant         Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  integrationToken   IntegrationToken      @relation(fields: [integrationTokenId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, action, idempotencyKey])
  @@index([restaurantId, createdAt])
  @@index([integrationTokenId, createdAt])
}

model ChatActivityLog {
  id               String   @id @default(cuid())
  restaurantId     String
  restaurantUserId String?
  action           String
  status           String
  chatId           String
  chatClientId     String?
  contactName      String?
  contactPhone     String?
  messageType      String
  messageContent   String?
  templateId       String?
  templateName     String?
  templateParameters Json?
  fileName         String?
  fileMimeType     String?
  fileSize         Int?
  externalMessageId String?
  externalResponse Json?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime @default(now())
  restaurant       Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantUser   RestaurantUser? @relation(fields: [restaurantUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([restaurantUserId, createdAt])
  @@index([chatId, createdAt])
}

model AuditLog {
  id              String        @id @default(cuid())
  restaurantId    String?
  platformUserId  String?
  restaurantUserId String?
  action          String
  targetType      String
  targetId        String
  metadata        Json?
  createdAt       DateTime      @default(now())
  restaurant      Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  platformUser    PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)
  restaurantUser  RestaurantUser? @relation(fields: [restaurantUserId], references: [id], onDelete: SetNull)

  @@index([restaurantId, action])
  @@index([platformUserId, createdAt])
  @@index([restaurantUserId, createdAt])
}
